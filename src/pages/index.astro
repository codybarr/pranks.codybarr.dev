---
import CodeSnippet from "../components/CodeSnippet.astro";
import "../styles/global.css";
---

<html lang="en" class="min-h-full scheme-dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Cody's Pranks</title>
    <meta
      name="description"
      content="Cody's Pranks — Harmless terminal mischief"
    />
  </head>
  <body
    class="min-h-full overflow-x-hidden bg-[#071117] font-sans text-[#f4f7f5]"
  >
    <div
      class="relative isolate grid min-h-screen place-items-center bg-[#0d1b24] bg-[radial-gradient(circle_at_20%_20%,rgba(91,140,255,0.18),transparent_28%),radial-gradient(circle_at_80%_30%,rgba(125,211,199,0.18),transparent_30%),radial-gradient(circle_at_50%_80%,rgba(214,168,95,0.14),transparent_32%),linear-gradient(180deg,#0d1b24,#071117)] px-5 py-8 before:pointer-events-none before:absolute before:inset-[-20%] before:-z-10 before:bg-[radial-gradient(circle_at_30%_35%,rgba(91,140,255,0.22),transparent_18%),radial-gradient(circle_at_70%_60%,rgba(125,211,199,0.18),transparent_20%)] before:opacity-[0.85] before:blur-[60px] before:content-[''] after:pointer-events-none after:absolute after:-inset-[20%] after:-z-10 after:bg-[radial-gradient(circle_at_65%_30%,rgba(214,168,95,0.14),transparent_16%),radial-gradient(circle_at_35%_75%,rgba(125,211,199,0.12),transparent_20%)] after:opacity-[0.85] after:blur-[60px] after:content-[''] max-sm:px-4 max-sm:py-6"
    >
      <main class="w-full max-w-220">
        <header class="mb-7">
          <p class="mb-3 text-[0.95rem] text-[#7dd3c7]">
            Harmless terminal mischief
          </p>
          <h1 class="text-[clamp(3rem,8vw,5.5rem)] leading-[0.96]">
            Cody's Pranks
          </h1>
          <p class="mt-4.5 text-[1.05rem] leading-[1.6] text-[#b7c4c7]">
            Tiny scripts. Simple pranks. Hilarious outcomes.
          </p>
        </header>

        <section class="flex flex-col gap-4">
          <CodeSnippet
            label="Code example for running pirate.sh"
            href="/pirate.sh"
            >curl -fsSL https://pranks.codybarr.dev/pirate.sh | bash</CodeSnippet
          >
          <CodeSnippet
            label="Code example for running dadjokes.sh"
            href="/dadjokes.sh"
            >curl -fsSL https://pranks.codybarr.dev/dadjokes.sh | bash</CodeSnippet
          >
        </section>
      </main>
    </div>
  </body>
</html>
